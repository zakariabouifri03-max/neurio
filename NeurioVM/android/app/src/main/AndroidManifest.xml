<?xml version="1.0" encoding="utf-8"?>
<!--
  NeurioVM manifest.

  Four things here are unusual and each has a reason:

  1. Four browser activities sharing one class, each with its own
     android:process. WebView profile isolation needs one process per device,
     and a process can only be declared statically.

  2. An exported, permission-less ContentProvider. It is the only supported way
     for the LSPosed module — running inside somebody else's process — to read
     the published identity. It serves synthetic data only, and the app refuses
     to serve anything while hooking is switched off.

  3. QUERY_ALL_PACKAGES. The hook target picker genuinely has to enumerate
     installed applications; there is no narrower API that answers "which apps
     are on this phone". The list is read-only.

  4. foregroundServiceType=specialUse plus its subtype property: a VM host is
     not one of the platform's predefined categories, and API 34 requires the
     property to be present.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Termux is detected through the package manager, not by statting its
         data directory (which Android 11+ forbids), so it must be queryable. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".NeurioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/NeurioTheme">

        <!-- ── Xposed / LSPosed module registration ────────────────────── -->
        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="NeurioVM — present a virtual handset identity (Build, ANDROID_ID, IMEI, MACs) to selected apps. Needs a device selected in the app first." />
        <meta-data android:name="xposedminversion" android:value="93" />

        <!-- ── screens ─────────────────────────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".DeviceActivity" android:exported="false" />
        <activity android:name=".EditorActivity" android:exported="false" />
        <activity android:name=".TerminalActivity" android:exported="false" />
        <activity android:name=".ConsoleActivity" android:exported="false" />
        <activity android:name=".HookAppsActivity" android:exported="false" />

        <!-- One class, four processes: four simultaneous isolated browsers. -->
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:process=":vm0"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/NeurioTheme.Browser" />
        <activity
            android:name=".BrowserSlot2"
            android:exported="false"
            android:process=":vm1"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/NeurioTheme.Browser" />
        <activity
            android:name=".BrowserSlot3"
            android:exported="false"
            android:process=":vm2"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/NeurioTheme.Browser" />
        <activity
            android:name=".BrowserSlot4"
            android:exported="false"
            android:process=":vm3"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/NeurioTheme.Browser" />

        <!-- ── VM host service ─────────────────────────────────────────── -->
        <service
            android:name=".vm.VmService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="virtual_machine_host" />
        </service>

        <!-- ── bridge to the LSPosed module ────────────────────────────── -->
        <provider
            android:name=".hook.HookProvider"
            android:authorities="com.neurio.vm.hook"
            android:exported="true"
            android:grantUriPermissions="false" />
    </application>
</manifest>
