<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon (API 26+). The foreground layer is the generated PNG in
  drawable-*dpi (created by tools/make-icons.py); below API 26 the legacy
  mipmap-*dpi/ic_launcher.png is used instead, so every launcher sees the same
  artwork.

  The foreground is drawn inside the 108dp layer with the artwork squeezed to
  the 72dp safe zone, which is why the pins survive any launcher mask.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
