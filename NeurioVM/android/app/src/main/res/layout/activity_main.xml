<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout style="@style/Header">

        <TextView
            style="@style/HeaderTitle"
            android:text="@string/app_name"
            android:textColor="@color/primary" />

        <TextView
            style="@style/HeaderSub"
            android:text="@string/main_subtitle" />

        <TextView
            android:id="@+id/vault_badge"
            style="@style/HeaderSub"
            android:fontFamily="monospace"
            android:textColor="@color/text_faint" />

        <TextView
            android:id="@+id/hook_badge"
            style="@style/HeaderSub"
            android:fontFamily="monospace"
            android:textColor="@color/text_faint" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/device_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/main_empty"
            android:textColor="@color/text_faint"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingBottom="6dp"
        android:text="@string/main_tap_hint"
        android:textColor="@color/text_faint"
        android:textSize="11sp" />

    <!-- Horizontal scroll: four buttons never fit a 360dp screen in one row. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elevated"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <Button
                android:id="@+id/btn_new"
                style="@style/Btn.Primary"
                android:text="@string/main_new" />

            <Button
                android:id="@+id/btn_random"
                style="@style/Btn"
                android:layout_marginLeft="8dp"
                android:text="@string/main_random" />

            <Button
                android:id="@+id/btn_console"
                style="@style/Btn"
                android:layout_marginLeft="8dp"
                android:text="@string/main_console" />

            <Button
                android:id="@+id/btn_import"
                style="@style/Btn"
                android:layout_marginLeft="8dp"
                android:text="@string/main_import" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
