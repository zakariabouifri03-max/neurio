<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- device badge + URL bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/bg_elevated"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/b_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:maxWidth="120dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="10sp"
            android:textColor="@color/primary" />

        <EditText
            android:id="@+id/b_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_input"
            android:hint="@string/browser_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:padding="8dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text_faint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/b_go"
            style="@style/Btn.Primary"
            android:layout_marginLeft="6dp"
            android:text="@string/browser_go" />
    </LinearLayout>

    <!-- nav strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elevated"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="6dp">

            <Button android:id="@+id/b_back" style="@style/Btn" android:text="@string/browser_back" />
            <Button android:id="@+id/b_forward" style="@style/Btn" android:layout_marginLeft="4dp" android:text="@string/browser_forward" />
            <Button android:id="@+id/b_reload" style="@style/Btn" android:layout_marginLeft="4dp" android:text="@string/browser_reload" />
            <Button android:id="@+id/b_verify" style="@style/Btn" android:layout_marginLeft="4dp" android:text="@string/browser_verify" />
            <Button android:id="@+id/b_home" style="@style/Btn" android:layout_marginLeft="4dp" android:text="@string/browser_home" />
            <Button android:id="@+id/b_clear" style="@style/Btn" android:layout_marginLeft="4dp" android:text="@string/browser_clear" />
            <Button android:id="@+id/b_ext" style="@style/Btn" android:layout_marginLeft="4dp" android:text="@string/browser_external" />
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/b_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:visibility="gone" />

    <TextView
        android:id="@+id/b_iframe_warn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/warn"
        android:padding="6dp"
        android:text="@string/browser_iframe_warn"
        android:textColor="#3A2A00"
        android:textSize="11sp"
        android:visibility="gone" />

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/b_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_elevated"
        android:fontFamily="monospace"
        android:padding="6dp"
        android:textSize="9sp"
        android:textColor="@color/text_faint"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
