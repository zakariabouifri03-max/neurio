{
  "name": "neurio-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first multitrack video editor",
  "author": "Neurio Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.neurio.studio",
    "productName": "Neurio Studio",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "sw.js",
      "src/editor.css",
      "src/editor/**/*",
      "icons/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Neurio-Studio-Windows-x64.${ext}"
    }
  }
}
