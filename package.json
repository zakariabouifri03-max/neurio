{
  "name": "hollowpine",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "SAWT+ volume-booster phone app, plus the HOLLOWPINE survival game, archived GHOSTLINE, racing, and downloadable procedural models.",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/sawt-browser.mjs && node tests/survival-browser.mjs",
    "test:browser:sawt": "node tests/sawt-browser.mjs",
    "test:browser:hollowpine": "node tests/survival-browser.mjs",
    "test:browser:ghostline": "node tests/browser.mjs",
    "build:racing": "node tools/build-singlefile.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "esbuild": "^0.28.2",
    "gltf-validator": "^2.0.0-dev.3.10"
  },
  "engines": {
    "node": ">=22"
  }
}
