{
  "name": "neurio-studio",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Neurio Studio — a professional browser-based multi-track video editor",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "desktop:dev": "npm run build && electron .",
    "desktop:win": "npm run build && electron-builder --win --x64 --publish never",
    "desktop:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "desktop:mac": "npm run build && electron-builder --mac --publish never",
    "android:assets": "node scripts/android-assets.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug assembleRelease",
    "icons": "node scripts/make-ico.mjs && node scripts/android-assets.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@types/dom-webcodecs": "^0.1.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "idb": "^8.0.4",
    "lucide-react": "^0.544.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.8"
  },
  "main": "electron/main.cjs",
  "author": "Neurio",
  "homepage": "https://github.com/zakariabouifri03-max/neurio",
  "build": {
    "appId": "com.neurio.studio",
    "productName": "Neurio Studio",
    "copyright": "Copyright © 2026 Neurio",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/assets/*.wasm",
      "dist/mediapipe/**"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.ico",
      "artifactName": "Neurio-Studio-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Neurio Studio",
      "artifactName": "Neurio-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Neurio-Studio-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "electron/resources/icon.png",
      "artifactName": "Neurio-Studio-${version}-linux-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video",
      "icon": "electron/resources/icon.png"
    },
    "npmRebuild": false
  }
}
