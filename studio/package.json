{
  "name": "neurio-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Neurio Studio — a professional browser-based multi-track video editor",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "idb": "^8.0.4",
    "lucide-react": "^0.544.0",
    "mp4-muxer": "^5.2.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "webm-muxer": "^5.1.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/dom-webcodecs": "^0.1.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
