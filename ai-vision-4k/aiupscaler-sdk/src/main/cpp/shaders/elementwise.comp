// AI Vision 4K — element-wise combine of two feature maps.
//
// The model format has an explicit Add op (residual connections inside the
// network, and the temporal model's history injection), so the GPU executor
// needs a kernel that is not a convolution. Everything is planar CHW float,
// exactly like sr_conv.comp, so tensors can be ping-ponged between the two
// pipelines without a relayout pass.
#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputA {
    float gA[];   // [C][H][W]
};
layout(std430, binding = 1) readonly buffer InputB {
    float gB[];   // [C][H][W] (broadcast on the channel axis when B.c == 1)
};
layout(std430, binding = 2) writeonly buffer Output {
    float gOut[]; // [C][H][W]
};

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint channels;
    uint bChannels;   // 1 == single channel operand, otherwise == channels
    uint mode;        // 0 add, 1 subtract, 2 multiply, 3 addScaled (a + b * scalar)
    float scalar;
    uint aChannels;   // mode 4 (concat): channels taken from A, the rest come from B
    uint reserved1;
} pc;

void main() {
    const ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (uint(pos.x) >= pc.width || uint(pos.y) >= pc.height) {
        return;
    }
    const uint plane = pc.width * pc.height;
    const uint spatial = uint(pos.y) * pc.width + uint(pos.x);

    // mode 4 (concat): the output holds [A channels][B channels]; both operands
    // share the spatial size, so one pass builds the concatenated tensor.
    if (pc.mode == 4u) {
        for (uint c = 0; c < pc.channels; ++c) {
            const float value = c < pc.aChannels ? gA[c * plane + spatial]
                                                 : gB[(c - pc.aChannels) * plane + spatial];
            gOut[c * plane + spatial] = value;
        }
        return;
    }

    for (uint c = 0; c < pc.channels; ++c) {
        const float a = gA[c * plane + spatial];
        const uint bc = pc.bChannels == 1u ? 0u : c;
        const float b = gB[bc * plane + spatial];
        float result;
        if (pc.mode == 1u) {
            result = a - b;
        } else if (pc.mode == 2u) {
            result = a * b;
        } else if (pc.mode == 3u) {
            result = a + b * pc.scalar;
        } else {
            result = a + b;
        }
        gOut[c * plane + spatial] = result;
    }
}
