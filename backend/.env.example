# Etsy Signal backend configuration
PORT=8787
HOST=0.0.0.0

# postgres | memory   (memory = zero-dependency demo, history lost on restart)
STORAGE=postgres
DATABASE_URL=postgres://localhost/etsy_signal

# Apply database/schema.sql automatically at boot (dev convenience)
DATABASE_AUTO_MIGRATE=0

# Comma-separated allowed CORS origins ("*" wildcard suffix supported)
CORS_ORIGINS=http://localhost:5173,chrome-extension://*,https://www.etsy.com

RATE_LIMIT_PER_MINUTE=240
