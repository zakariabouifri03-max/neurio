<Project Sdk="Microsoft.NET.Sdk">

  <!-- ADZAK Lite Browser — lightweight WebView2 (Chromium) desktop browser.
       Target: Windows 10/11 x64, tuned for PCs with 8 GB RAM. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <AssemblyName>ADZAKLiteBrowser</AssemblyName>
    <RootNamespace>AdzakLiteBrowser</RootNamespace>
    <Product>ADZAK Lite Browser</Product>
    <Description>Lightweight Chromium (WebView2) browser with data saver, ad/tracker blocking, tab suspension and downloads — tuned for 8 GB RAM PCs.</Description>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\adzak.ico</ApplicationIcon>
    <!-- Friendly error if someone builds without the WebView2 runtime present at run time:
         handled in Program.cs with download guidance. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

</Project>
