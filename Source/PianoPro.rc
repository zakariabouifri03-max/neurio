#include <winver.h>

IDI_APPICON ICON "..\\assets\\icons\\pianopro.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Piano Pro"
            VALUE "FileDescription",  "Piano Pro — 88-key virtual piano"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "PianoPro"
            VALUE "OriginalFilename", "PianoPro.exe"
            VALUE "ProductName",      "Piano Pro"
            VALUE "ProductVersion",   "1.0.0"
            VALUE "LegalCopyright",   "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
