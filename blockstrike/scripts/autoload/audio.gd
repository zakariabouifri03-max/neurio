extends Node
## Sound manager. All sounds are original, generated by tools/gen_audio.py into res://assets/audio.
## Disabled automatically on headless dedicated servers.

const SFX := ["shot_ar", "shot_smg", "shot_sg", "shot_sr", "shot_pistol", "swing", "pin", "throw", "explosion", "smoke",
	"reload", "heal", "hit", "hit_head", "kill", "knock", "death", "pickup", "step", "block", "supply", "click", "buy",
	"levelup", "victory", "defeat", "countdown", "zone", "wind", "plane", "chute", "error", "swap"]
const MUSIC := ["music_menu", "music_match"]
const LOOPS := ["wind", "plane", "music_menu", "music_match"]

var enabled := true
var streams := {}
var p3d: Array[AudioStreamPlayer3D] = []
var p2d: Array[AudioStreamPlayer] = []
var music_a: AudioStreamPlayer
var music_b: AudioStreamPlayer
var _i3 := 0
var _i2 := 0
var _cur_music := ""
var loop_player: AudioStreamPlayer

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	if DisplayServer.get_name() == "headless":
		enabled = false
		return
	for bus in ["Music", "SFX"]:
		if AudioServer.get_bus_index(bus) < 0:
			AudioServer.add_bus()
			var idx := AudioServer.bus_count - 1
			AudioServer.set_bus_name(idx, bus)
			AudioServer.set_bus_send(idx, "Master")
	for n in SFX + MUSIC:
		if not _try_load(n, "res://assets/audio/%s.wav" % n):
			_try_load(n, "res://assets/audio/%s.ogg" % n)
	for i in 20:
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.unit_size = 7.0
		p.max_distance = 160.0
		p.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p.max_polyphony = 1
		add_child(p)
		p3d.append(p)
	for i in 10:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		p2d.append(p)
	music_a = AudioStreamPlayer.new()
	music_a.bus = "Music"
	add_child(music_a)
	music_b = AudioStreamPlayer.new()
	music_b.bus = "Music"
	add_child(music_b)
	loop_player = AudioStreamPlayer.new()
	loop_player.bus = "SFX"
	add_child(loop_player)
	Settings.apply()

func _try_load(n: String, path: String) -> bool:
	if not ResourceLoader.exists(path):
		return false
	var s = load(path)
	if s is AudioStreamOggVorbis:
		(s as AudioStreamOggVorbis).loop = n in LOOPS
	if s is AudioStream:
		streams[n] = s
		return true
	return false

func play_3d(n: String, pos: Vector3, vol_db := 0.0, pitch := 1.0) -> void:
	if not enabled or not streams.has(n):
		return
	var cam := get_viewport().get_camera_3d()
	if cam and cam.global_position.distance_to(pos) > 170.0:
		return
	var p := p3d[_i3]
	_i3 = (_i3 + 1) % p3d.size()
	p.stream = streams[n]
	p.volume_db = vol_db
	p.pitch_scale = pitch
	p.global_position = pos
	p.play()

func play_ui(n: String, vol_db := 0.0, pitch := 1.0) -> void:
	if not enabled or not streams.has(n):
		return
	var p := p2d[_i2]
	_i2 = (_i2 + 1) % p2d.size()
	p.stream = streams[n]
	p.volume_db = vol_db
	p.pitch_scale = pitch
	p.play()

func click() -> void:
	play_ui("click", -6.0)

func loop(n: String, vol_db := -10.0) -> void:
	if not enabled:
		return
	if n == "":
		loop_player.stop()
		return
	if not streams.has(n):
		return
	if loop_player.stream == streams[n] and loop_player.playing:
		loop_player.volume_db = vol_db
		return
	loop_player.stream = streams[n]
	loop_player.volume_db = vol_db
	loop_player.play()

func music(n: String) -> void:
	if not enabled or n == _cur_music:
		return
	_cur_music = n
	var old := music_a if music_a.playing else music_b
	var nxt := music_b if old == music_a else music_a
	if streams.has(n):
		nxt.stream = streams[n]
		nxt.volume_db = -40.0
		nxt.play()
		var tw := create_tween()
		tw.tween_property(nxt, "volume_db", 0.0, 1.2)
	if old.playing:
		var tw2 := create_tween()
		tw2.tween_property(old, "volume_db", -40.0, 1.2)
		tw2.tween_callback(old.stop)

func vibrate(ms: int) -> void:
	if enabled and Settings.get_v("vibration") and Settings.is_mobile:
		Input.vibrate_handheld(ms)
