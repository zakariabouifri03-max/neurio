; BlockStrike Royale - Godot project configuration
; Target engine: Godot 4.4.x  |  Primary platform: Android (landscape)
;
; NOTE: this file is hand written and validated by tools/validate/validate_project.py

config_version=5

[application]

config/name="BlockStrike Royale"
config/description="Original voxel battle royale shooter. Emeral Island, Clash Squad, 2v2 Arena, LAN and internet multiplayer."
config/version="0.1.0"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.05, 0.07, 0.12, 1)
boot_splash/show_image=false

[autoload]

GameConfig="*res://scripts/core/game_config.gd"
ContentDB="*res://scripts/core/content_db.gd"
SaveManager="*res://scripts/core/save_manager.gd"
Settings="*res://scripts/core/settings_service.gd"
Economy="*res://scripts/core/economy.gd"
Progression="*res://scripts/core/progression.gd"
Missions="*res://scripts/core/missions.gd"
Inventory="*res://scripts/core/inventory_service.gd"
MatchConfig="*res://scripts/core/match_config.gd"
AudioDirector="*res://scripts/core/audio_director.gd"
NetworkManager="*res://scripts/core/network_manager.gd"
Lobby="*res://scripts/core/lobby.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="prop"
3d_physics/layer_4="loot"
3d_physics/layer_5="projectile"
3d_physics/layer_6="hitbox"
3d_physics/layer_7="bot"
3d_physics/layer_8="trigger"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=18.0
3d/default_gravity_vector=Vector3(0, -1, 0)

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.29, 0.55, 0.78, 1)
textures/default_filters/anisotropic_filtering_level=0

