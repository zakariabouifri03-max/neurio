{
  "manifest_version": 3,
  "name": "AI Download Manager Pro — Link Handoff",
  "version": "1.0.0",
  "description": "Send a link you explicitly choose to AI Download Manager Pro. No browsing-history permission.",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "AI Download Manager Pro",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-download-manager-pro@local",
      "strict_min_version": "128.0"
    }
  }
}
