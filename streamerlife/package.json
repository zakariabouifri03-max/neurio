{
  "name": "streamer-life-3d",
  "version": "1.0.0",
  "description": "Streamer Life 3D — life & streaming simulator in a 3D city, with online multiplayer",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/mp-server.mjs",
    "desktop": "electron .",
    "build:web": "node tools/build-singlefile.mjs",
    "build:apk": "python3 tools/build-apk.py",
    "dist": "npm run build:web && electron-builder --win --x64",
    "dist:all": "npm run build:web && electron-builder -mwl"
  },
  "build": {
    "appId": "com.neurio.streamerlife",
    "productName": "Streamer Life 3D",
    "files": ["index.html", "src/**", "vendor/**", "icons/**", "desktop/**", "manifest.webmanifest"],
    "win": { "target": ["nsis", "portable"], "icon": "icons/icon-512.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" }
}
