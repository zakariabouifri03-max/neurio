NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://voxora:local-development-only@localhost:5432/voxora
APP_ORIGIN=http://localhost:5173
# Comma-separated trusted browser origins; add your exact preview origin if needed.
EXTRA_ORIGINS=
SESSION_DAYS=30
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Voxora <hello@localhost>
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-development-secret-at-least-32-characters
UPLOAD_DIR=storage
MAX_UPLOAD_MB=10
USER_QUOTA_MB=100
# Renderer variables are PUBLIC, never put secrets here. Blank API uses same origin.
VITE_API_URL=
# Production desktop builds require the public HTTPS backend URL here.
