{
  "name": "animai-studio",
  "productName": "ANIMAI STUDIO",
  "version": "1.0.0",
  "description": "ANIMAI STUDIO - local-first AI-assisted 2D animation for Windows.",
  "author": "ANIMAI STUDIO",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakariabouifri03-max/neurio.git"
  },
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "commonjs",
  "scripts": {
    "check": "node scripts/check-deps.mjs",
    "dev": "npm run check && vite --host 0.0.0.0 --port 5173",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "electron:dev": "node scripts/electron-dev.mjs",
    "pack": "vite build && electron-builder --win portable nsis --publish never",
    "dist": "vite build && electron-builder --win portable nsis --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "start": "npm run dev"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "studio.animai.app",
    "productName": "ANIMAI STUDIO",
    "copyright": "Copyright © ANIMAI STUDIO",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "examples",
        "to": "examples"
      }
    ],
    "win": {
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "ANIMAI-STUDIO.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ANIMAI STUDIO",
      "artifactName": "ANIMAI-STUDIO-Setup.exe",
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage"],
      "category": "Graphics"
    }
  }
}
