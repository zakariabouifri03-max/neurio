# Server
PORT=3000

# Optional: enables GPT-powered replies. Without it, the built-in rule brain is used (works offline).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: Twilio (for real phone calls). The webhook URLs work without these set —
# Twilio just needs your public /voice/incoming URL. These are for future SMS alerts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
