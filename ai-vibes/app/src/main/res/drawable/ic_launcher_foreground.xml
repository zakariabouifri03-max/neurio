<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher foreground: neon sound-wave "V" mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Circular glow ring -->
    <path
        android:pathData="M54,54m-30,0a30,30 0,1 1,60 0a30,30 0,1 1,-60 0"
        android:strokeWidth="2.2"
        android:strokeColor="#66B24BF3"
        android:fillColor="#00000000" />

    <!-- Equaliser bars inside the ring -->
    <path
        android:pathData="M41,62 L41,46"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="41" android:startY="46" android:endX="41" android:endY="62">
                <item android:offset="0" android:color="#FF22D3EE" />
                <item android:offset="1" android:color="#FF3B82F6" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M50,66 L50,42"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="50" android:startY="42" android:endX="50" android:endY="66">
                <item android:offset="0" android:color="#FF22D3EE" />
                <item android:offset="1" android:color="#FFB24BF3" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M59,62 L59,46"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="59" android:startY="46" android:endX="59" android:endY="62">
                <item android:offset="0" android:color="#FFB24BF3" />
                <item android:offset="1" android:color="#FF3B82F6" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M68,57 L68,51"
        android:strokeWidth="4"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:type="linear" android:startX="68" android:startY="51" android:endX="68" android:endY="57">
                <item android:offset="0" android:color="#FFB24BF3" />
                <item android:offset="1" android:color="#FF22D3EE" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M32,57 L32,51"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeColor="#FF3B82F6" />
</vector>
