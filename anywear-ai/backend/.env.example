# Anywear AI backend configuration
# Copy to .env and adjust. NEVER ship real secrets in the extension or repo.

# --- Storage ---
DATA_DIR=./data
MAX_UPLOAD_MB=12
MAX_PERSON_MB=8
MAX_GARMENT_MB=8

# --- Security ---
# Set an API key to require Bearer auth on all /api endpoints (except /api/health)
API_KEY=
# Comma-separated CORS origins for the dashboard / extension origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173

# --- Limits ---
RATE_LIMIT_RPM=30
JOB_TIMEOUT_S=120

# --- AI provider (see ai-engine/README.md and docs/AI_ENGINE.md) ---
# dev-composite: local CPU composite (development mode, no GPU needed)
# idmvton:        self-hosted GPU inference server
AI_PROVIDER=dev-composite
AI_ENGINE_URL=
AI_ENGINE_API_KEY=
