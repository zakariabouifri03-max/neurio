<?xml version="1.0" encoding="utf-8"?>
<!-- Accent card: used for the primary action on a screen (HOST GAME / JOIN GAME). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#2628E0C8"
        android:endColor="#14101828" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#5528E0C8" />
</shape>
