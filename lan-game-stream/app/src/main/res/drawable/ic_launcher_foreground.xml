<?xml version="1.0" encoding="utf-8"?>
<!--
  Neon gamepad + cast waves: the phone casts a running game onto another phone.
  Only M/L/Q/C/Z path commands are used (maximum VectorDrawable compatibility).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer cast wave -->
    <path
        android:pathData="M28,36 Q54,14 80,36"
        android:strokeColor="#7C5CFF"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />
    <!-- inner cast wave -->
    <path
        android:pathData="M37,44 Q54,30 71,44"
        android:strokeColor="#28E0C8"
        android:strokeWidth="3.4"
        android:strokeLineCap="round" />

    <!-- gamepad body (rounded silhouette) -->
    <path
        android:fillColor="#28E0C8"
        android:pathData="M40,54 L68,54 C76.8,54 82,60.4 82,68 L82,71 C82,77.6 74.6,80.8 70.2,75.8 L68.4,73.8 L39.6,73.8 L37.8,75.8 C33.4,80.8 26,77.6 26,71 L26,68 C26,60.4 31.2,54 40,54 Z" />

    <!-- d-pad (vertical + horizontal bars) -->
    <path
        android:fillColor="#070B14"
        android:pathData="M47.4,58 L50.6,58 L50.6,63.4 L56,63.4 L56,66.6 L50.6,66.6 L50.6,72 L47.4,72 L47.4,66.6 L42,66.6 L42,63.4 L47.4,63.4 Z" />

    <!-- action buttons -->
    <path
        android:fillColor="#070B14"
        android:pathData="M66,57.6 L69.6,57.6 L69.6,61.2 L66,61.2 Z" />
    <path
        android:fillColor="#070B14"
        android:pathData="M70.8,62.4 L74.4,62.4 L74.4,66 L70.8,66 Z" />
    <path
        android:fillColor="#070B14"
        android:pathData="M66,67.2 L69.6,67.2 L69.6,70.8 L66,70.8 Z" />
    <path
        android:fillColor="#070B14"
        android:pathData="M61.2,62.4 L64.8,62.4 L64.8,66 L61.2,66 Z" />
</vector>
