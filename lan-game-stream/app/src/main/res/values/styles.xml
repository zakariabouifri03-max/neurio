<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===================== Text ===================== -->

    <style name="Text" parent="android:Widget.TextView">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.Display">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Title">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Headline">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Mono">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Stat">
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.Accent">
        <item name="android:textColor">@color/accent_primary</item>
    </style>

    <style name="Text.Warn">
        <item name="android:textColor">@color/accent_warn</item>
    </style>

    <style name="Text.Danger">
        <item name="android:textColor">@color/accent_danger</item>
    </style>

    <!-- ===================== Containers ===================== -->

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_marginBottom">@dimen/space_m</item>
    </style>

    <style name="Card.Accent">
        <item name="android:background">@drawable/bg_card_accent</item>
    </style>

    <style name="SectionHeader">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:layout_marginTop">@dimen/space_l</item>
        <item name="android:layout_marginBottom">@dimen/space_s</item>
    </style>

    <!-- ===================== Buttons ===================== -->

    <style name="Button" parent="android:Widget.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_button_ghost</item>
    </style>

    <style name="Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/bg_deep</item>
    </style>

    <style name="Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
    </style>

    <style name="Chip" parent="android:Widget.Button">
        <item name="android:minHeight">@dimen/chip_height</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Chip.Selected">
        <item name="android:background">@drawable/bg_chip_selected</item>
        <item name="android:textColor">@color/accent_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ===================== Inputs ===================== -->

    <style name="Field" parent="android:Widget.EditText">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingLeft">@dimen/space_m</item>
        <item name="android:paddingRight">@dimen/space_m</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- ===================== Lists ===================== -->

    <style name="List">
        <item name="android:divider">@null</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="android:listSelector">@android:color/transparent</item>
        <item name="android:scrollbars">vertical</item>
        <item name="android:paddingBottom">@dimen/space_l</item>
        <item name="android:clipToPadding">false</item>
    </style>

</resources>
