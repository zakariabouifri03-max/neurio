<?xml version="1.0" encoding="utf-8"?>
<!-- Filebox launcher icon: a parcel on a teal→cyan field. Vector so it scales
     to any density with no PNG assets in the repo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
      <gradient android:startX="0" android:startY="0" android:endX="108" android:endY="108"
                android:type="linear">
        <item android:offset="0" android:color="#FF12A37F"/>
        <item android:offset="1" android:color="#FF0E7490"/>
      </gradient>
    </aapt:attr>
  </path>

  <!-- box body -->
  <path android:fillColor="#FFF0F8FF"
        android:pathData="M28,44 L80,44 L80,80 L28,80 Z"/>
  <!-- lid -->
  <path android:fillColor="#FFF0F8FF"
        android:pathData="M25,32 L83,32 L83,44 L25,44 Z"/>
  <!-- seam under the lid -->
  <path android:fillColor="#FF0B1120"
        android:pathData="M28,43 L80,43 L80,45.5 L28,45.5 Z"/>
  <!-- tape -->
  <path android:fillColor="#FF22D3A5"
        android:pathData="M50,44 L58,44 L58,80 L50,80 Z"/>
  <!-- bottom shading -->
  <path android:fillColor="#33000000"
        android:pathData="M28,70 L80,70 L80,80 L28,80 Z"/>
</vector>
