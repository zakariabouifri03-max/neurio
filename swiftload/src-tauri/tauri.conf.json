{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SwiftLoad",
  "version": "1.0.0",
  "identifier": "com.swiftload.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SwiftLoad",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true,
        "visible": true,
        "dragDropEnabled": false,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": false,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 SwiftLoad",
    "category": "Utility",
    "shortDescription": "Fast, resumable Windows download manager",
    "longDescription": "SwiftLoad downloads files over HTTP and HTTPS with real pause and resume, segmented transfers when the server supports byte ranges, a queue with a configurable concurrency limit, automatic retries with exponential backoff, a working bandwidth limiter, integrity verification, and a local SQLite history. It runs completely offline: no account, no cloud service, no telemetry.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "SwiftLoad",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
