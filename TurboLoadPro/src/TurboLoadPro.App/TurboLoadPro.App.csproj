<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>TurboLoadPro</RootNamespace>
    <AssemblyName>TurboLoadPro</AssemblyName>
    <ApplicationIcon>Assets\TurboLoadPro.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Authors>TurboLoad Pro</Authors>
    <Product>TurboLoad Pro</Product>
    <Description>Secure, resumable direct HTTP download manager.</Description>
    <Copyright>Copyright © TurboLoad Pro</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TurboLoadPro.Core\TurboLoadPro.Core.csproj" />
  </ItemGroup>
</Project>
