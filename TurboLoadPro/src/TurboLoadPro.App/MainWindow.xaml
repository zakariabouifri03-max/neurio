<Window x:Class="TurboLoadPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:core="clr-namespace:TurboLoadPro.Core.Models;assembly=TurboLoadPro.Core"
        Title="TurboLoad Pro" Width="1500" Height="940" MinWidth="1120" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" AllowDrop="True"
        DragEnter="Window_DragEnter" Drop="Window_Drop" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,10" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="70" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TinyButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Padding" Value="5,3" />
            <Setter Property="MinWidth" Value="27" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid Background="{DynamicResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Native-feeling title strip; the app never enters elevated/admin mode. -->
            <Grid Grid.Row="0" Background="{DynamicResource SidebarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="25" Height="25" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,9,0">
                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="TurboLoad" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text=" PRO" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
                <Grid Grid.Column="1">
                    <TextBlock Text="DIRECT DOWNLOADS  /  DASHBOARD" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Content="—" ToolTip="Minimize" Style="{StaticResource TinyButton}" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="□" ToolTip="Maximize / restore" Style="{StaticResource TinyButton}" Click="Maximize_Click" Margin="5,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                        <Button Content="×" ToolTip="Close" Style="{StaticResource TinyButton}" Click="Close_Click" Margin="5,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="True" Margin="15,20,15,18">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,0">
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="5,0,5,15" />
                            <Button Style="{StaticResource NavButton}" Click="IntegrationHelp_Click" Content="&#xE774;   Browser handoff" FontFamily="Segoe MDL2 Assets" />
                            <Button Style="{StaticResource NavButton}" Click="Settings_Click" Content="&#xE713;   Settings" FontFamily="Segoe MDL2 Assets" />
                            <TextBlock Text="PRIVATE BY DESIGN" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" Margin="14,18,0,0" />
                            <TextBlock Text="No browsing history or credentials are collected." Foreground="{DynamicResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap" Margin="14,5,5,4" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="WORKSPACE" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,10" />
                            <Button Tag="All" Style="{StaticResource NavButton}" Click="Filter_Click" Content="&#xE8A5;   All downloads" FontFamily="Segoe MDL2 Assets" />
                            <Button Tag="Active" Style="{StaticResource NavButton}" Click="Filter_Click" Content="&#xE768;   Active" FontFamily="Segoe MDL2 Assets" />
                            <Button Tag="Queued" Style="{StaticResource NavButton}" Click="Filter_Click" Content="&#xE8FD;   Queue" FontFamily="Segoe MDL2 Assets" />
                            <Button Tag="Completed" Style="{StaticResource NavButton}" Click="Filter_Click" Content="&#xE73E;   Completed" FontFamily="Segoe MDL2 Assets" />
                            <Button Tag="Failed" Style="{StaticResource NavButton}" Click="Filter_Click" Content="&#xE783;   Attention needed" FontFamily="Segoe MDL2 Assets" />
                            <Border Style="{StaticResource SurfaceCard}" Margin="4,24,4,0" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="TRANSFER HEALTH" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="  TLS validation on" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Text="Range-aware • resumable • no auto-run" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="26,24,26,30">
                        <Grid Margin="2,0,2,16">
                            <StackPanel>
                                <TextBlock Text="Downloads" FontSize="26" FontWeight="Bold" />
                                <TextBlock Text="A clear view of every transfer, from first byte to finish." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Content="＋  Add download" Style="{StaticResource PrimaryButton}" Click="FocusUrl_Click" />
                        </Grid>

                        <Border Style="{StaticResource SurfaceCard}" Margin="0,0,0,16" Padding="17">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Paste a direct HTTP or HTTPS link" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="ZIP, ISO, installer, video, document and other direct files" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,10" />
                                    <TextBox x:Name="UrlBox" Style="{StaticResource InputBox}" Height="42" VerticalContentAlignment="Center"
                                             ToolTip="Paste a direct HTTP or HTTPS file URL" KeyDown="UrlBox_KeyDown" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                                    <Button Content="Paste" Style="{StaticResource SecondaryButton}" Click="Paste_Click" Margin="0,0,8,0" />
                                    <Button Content="Start download" Style="{StaticResource PrimaryButton}" Click="AddDownload_Click" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Save to" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding DownloadDirectoryLabel}" Foreground="{DynamicResource TextBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="490" />
                                    <Button Content="Change" Style="{StaticResource IconButton}" Padding="9,3" FontSize="10" Click="Settings_Click" Margin="8,0,0,0" />
                                    <TextBlock Text="  •  Drop a URL or .url shortcut here" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="ClipboardBanner" Style="{StaticResource SurfaceCard}" Padding="12" Margin="0,0,0,14" Visibility="Collapsed" BorderBrush="{DynamicResource AccentBrush}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Import link" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="ImportClipboard_Click" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="LINK DETECTED" Foreground="{DynamicResource AccentBrush}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock x:Name="ClipboardHostText" Text="A direct link is in your clipboard." FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="470" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,16">
                            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL SPEED" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GlobalSpeedText}" FontSize="25" FontWeight="Bold" Margin="0,9,0,0" />
                                    <TextBlock Text="Actual network throughput" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ActiveCount}" FontSize="25" FontWeight="Bold" Margin="0,9,0,0" />
                                    <TextBlock Text="In progress now" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCard}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="IN QUEUE" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding QueuedCount}" FontSize="25" FontWeight="Bold" Margin="0,9,0,0" />
                                    <TextBlock Text="Waiting for a slot" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SurfaceCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="COMPLETED" Foreground="{DynamicResource MutedTextBrush}" FontSize="9" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CompletedCount}" FontSize="25" FontWeight="Bold" Margin="0,9,0,0" />
                                    <TextBlock Text="In download history" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource SurfaceCard}" Padding="0">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Top" Margin="17,16,17,12">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Transfer list" FontSize="16" FontWeight="Bold" />
                                            <TextBlock Text="Per-download progress, connection count, speed and controls" Foreground="{DynamicResource MutedTextBrush}" FontSize="10" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <ComboBox Width="145" Height="32" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="Sort_SelectionChanged">
                                            <ComboBoxItem Content="Newest first" />
                                            <ComboBoxItem Content="Oldest first" />
                                            <ComboBoxItem Content="Name A–Z" />
                                            <ComboBoxItem Content="Progress" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,13,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="All" Content="All" Style="{StaticResource FilterButton}" Click="Filter_Click" Margin="0,0,6,0" />
                                            <Button Tag="Active" Content="Active" Style="{StaticResource FilterButton}" Click="Filter_Click" Margin="0,0,6,0" />
                                            <Button Tag="Queued" Content="Queued" Style="{StaticResource FilterButton}" Click="Filter_Click" Margin="0,0,6,0" />
                                            <Button Tag="Completed" Content="Completed" Style="{StaticResource FilterButton}" Click="Filter_Click" Margin="0,0,6,0" />
                                            <Button Tag="Failed" Content="Failed" Style="{StaticResource FilterButton}" Click="Filter_Click" />
                                        </StackPanel>
                                        <TextBox x:Name="SearchBox" Style="{StaticResource InputBox}" Width="210" Height="31" Padding="9,5" HorizontalAlignment="Right" VerticalContentAlignment="Center" ToolTip="Search by file name or folder" TextChanged="SearchBox_TextChanged" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock DockPanel.Dock="Bottom" Text="Downloads are saved as temporary files until size and range checks pass. Files are never run automatically." Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="17,12,17,15" TextWrapping="Wrap" />
                                <DataGrid x:Name="DownloadsGrid" ItemsSource="{Binding FilteredDownloads}" MinHeight="310" MaxHeight="520"
                                          SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="FILE" Width="2.0*" MinWidth="190" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                                                        <TextBlock Text="{Binding SecondaryText}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SecondaryText}" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="STATUS" Width="0.9*" MinWidth="95" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" /></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="PROGRESS" Width="1.65*" MinWidth="170" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid Margin="0,0,0,4">
                                                            <TextBlock Text="{Binding ProgressText}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Text="{Binding PercentText}" FontSize="9" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                                        </Grid>
                                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsIndeterminate}" Height="7" BorderThickness="0" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource AccentBrush}" />
                                                        <ItemsControl ItemsSource="{Binding Segments}" Visibility="{Binding HasSegments, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,5,0,0">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate><ProgressBar Value="{Binding Value}" Maximum="100" Width="6" Height="3" Margin="1,0" BorderThickness="0" Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource SuccessBrush}" /></DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="SPEED" Width="0.75*" MinWidth="75" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SpeedText}" FontSize="10" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="ETA" Width="0.52*" MinWidth="54" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EtaText}" FontSize="10" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="PRIORITY" Width="0.75*" MinWidth="78">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedValue="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" IsEnabled="{Binding IsQueued}">
                                                        <ComboBoxItem Content="Low" Tag="{x:Static core:DownloadPriority.Low}" />
                                                        <ComboBoxItem Content="Normal" Tag="{x:Static core:DownloadPriority.Normal}" />
                                                        <ComboBoxItem Content="High" Tag="{x:Static core:DownloadPriority.High}" />
                                                    </ComboBox>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="ACTIONS" Width="1.55*" MinWidth="142" IsReadOnly="True">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <Button Content="{Binding ToggleGlyph}" ToolTip="{Binding ToggleText}" Tag="{Binding Id}" IsEnabled="{Binding CanToggle}" Style="{StaticResource TinyButton}" Click="Toggle_Click" />
                                                        <Button Content="↻" ToolTip="Retry failed or cancelled download" Tag="{Binding Id}" IsEnabled="{Binding CanRetry}" Style="{StaticResource TinyButton}" Margin="3,0,0,0" Click="Retry_Click" />
                                                        <Button Content="⟲" ToolTip="Restart from the beginning" Tag="{Binding Id}" IsEnabled="{Binding CanRestart}" Style="{StaticResource TinyButton}" Margin="3,0,0,0" Click="Restart_Click" />
                                                        <Button Content="×" ToolTip="Cancel and discard partial data" Tag="{Binding Id}" IsEnabled="{Binding CanCancel}" Style="{StaticResource TinyButton}" Margin="3,0,0,0" Click="Cancel_Click" />
                                                        <Button Content="↗" ToolTip="Open completed file" Tag="{Binding Id}" IsEnabled="{Binding CanOpen}" Style="{StaticResource TinyButton}" Margin="3,0,0,0" Click="OpenFile_Click" />
                                                        <Button Content="▣" ToolTip="Open containing folder" Tag="{Binding Id}" IsEnabled="{Binding CanOpen}" Style="{StaticResource TinyButton}" Margin="3,0,0,0" Click="OpenFolder_Click" />
                                                    </WrapPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="TurboLoad Pro only supports direct HTTP/HTTPS files. It does not bypass DRM, authentication, paywalls or site restrictions." Foreground="{DynamicResource MutedTextBrush}" FontSize="9" Margin="3,13,3,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
