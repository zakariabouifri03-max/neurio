#!/usr/bin/env sh
# Small wrapper bootstrap. Downloads the pinned Gradle distribution when no matching
# Gradle 8.9 installation is already available; Android Studio supplies JDK 17.
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=8.9
GRADLE_SHA256=d725d707bfabd4dfdc958c624003b3c80accc03f7037b5122c4b1d0ef15cecab
GRADLE_USER_HOME=${GRADLE_USER_HOME:-"${HOME}/.gradle"}
DIST_HOME="$GRADLE_USER_HOME/wrapper/dists/gradle-${GRADLE_VERSION}-bin/neurio"
DIST_DIR="$DIST_HOME/gradle-${GRADLE_VERSION}"

if [ ! -x "$DIST_DIR/bin/gradle" ]; then
  mkdir -p "$DIST_HOME"
  ZIP="$DIST_HOME/gradle-${GRADLE_VERSION}-bin.zip"
  if [ ! -f "$ZIP" ]; then
    URL="https://services.gradle.org/distributions/gradle-${GRADLE_VERSION}-bin.zip"
    if command -v curl >/dev/null 2>&1; then
      curl -fL --retry 2 "$URL" -o "$ZIP"
    elif command -v wget >/dev/null 2>&1; then
      wget -q "$URL" -O "$ZIP"
    else
      echo "Install curl/wget or Gradle ${GRADLE_VERSION} to bootstrap this project." >&2
      exit 1
    fi
  fi
  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA256=$(sha256sum "$ZIP" | awk '{print $1}')
  elif command -v shasum >/dev/null 2>&1; then
    ACTUAL_SHA256=$(shasum -a 256 "$ZIP" | awk '{print $1}')
  else
    echo "sha256sum or shasum is required to verify the Gradle distribution." >&2
    exit 1
  fi
  if [ "$ACTUAL_SHA256" != "$GRADLE_SHA256" ]; then
    echo "Gradle distribution checksum mismatch; refusing to run it." >&2
    rm -f "$ZIP"
    exit 1
  fi
  if ! command -v unzip >/dev/null 2>&1; then
    echo "unzip is required to unpack Gradle ${GRADLE_VERSION}." >&2
    exit 1
  fi
  unzip -q -o "$ZIP" -d "$DIST_HOME"
fi

exec "$DIST_DIR/bin/gradle" -p "$APP_HOME" "$@"
