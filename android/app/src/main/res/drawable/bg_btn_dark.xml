<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#22304F" />
            <corners android:radius="@dimen/btn_radius" />
            <stroke android:width="1dp" android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151E33" />
            <corners android:radius="@dimen/btn_radius" />
            <stroke android:width="1dp" android:color="@color/stroke_soft" />
        </shape>
    </item>
</selector>
