    <!-- Offline -->
    <string name="offline_title">Offline viewing</string>
    <string name="offline_intro">VYRO PLAY streams with the official YouTube player. Downloading YouTube videos is not permitted by YouTube\'s Terms of Service, so this app never extracts streams or bypasses DRM. Here is what you can do instead.</string>
    <string name="offline_premium_title">YouTube Premium</string>
    <string name="offline_premium_body">The only supported way to save YouTube videos for offline playback in the YouTube app. Background play and ad-free viewing are included.</string>
    <string name="offline_music_title">YouTube Music Premium</string>
    <string name="offline_music_body">Lets you download music videos and songs for offline listening.</string>
    <string name="offline_creators_title">Official downloads from creators</string>
    <string name="offline_creators_body">Many channels offer their own files. Save them to your device, then play them in VYRO PLAY under “My videos”.</string>
    <string name="offline_local_title">Play your own files</string>
    <string name="offline_local_body">Any video you own works fully offline — no account, no subscription.</string>
    <string name="offline_data_saver_title">Save mobile data</string>
    <string name="offline_data_saver_body">Turn on Data Saver in Settings to cap streaming quality at 480p on mobile networks.</string>
