<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Neurio" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/accent_cyan</item>
        <item name="colorOnPrimary">#06121A</item>
        <item name="colorSecondary">@color/accent_violet</item>
        <item name="colorSecondaryVariant">@color/accent_violet</item>
        <item name="colorOnSecondary">#120B26</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_main</item>
        <item name="android:colorAccent">@color/accent_cyan</item>
        <item name="android:colorControlActivated">@color/accent_cyan</item>
    </style>

    <style name="Theme.Neurio.Fullscreen" parent="Theme.Neurio">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="NeurioBigButton">
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">#05121B</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:padding">18dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NeurioDarkButton">
        <item name="android:background">@drawable/bg_btn_dark</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">14dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NeurioDangerButton">
        <item name="android:background">@drawable/bg_btn_danger</item>
        <item name="android:textColor">#210A12</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="NeurioCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="NeurioSectionTitle">
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
    </style>

    <style name="PerfRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
    </style>

    <style name="PerfLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PerfValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
