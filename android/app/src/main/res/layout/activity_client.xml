<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="@string/title_join"
            android:textColor="@color/text_main"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScanState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/scan_searching"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Manual connect -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etManualIp"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/manual_ip_hint"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnManualConnect"
                style="@style/NeurioDarkButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:text="@string/manual_connect" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/available_hosts"
            style="@style/NeurioSectionTitle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvEmptyHosts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="26dp"
            android:text="@string/no_hosts"
            android:textColor="@color/text_dim"
            android:textSize="13sp" />

        <!-- Pairing card -->
        <LinearLayout
            android:id="@+id/cardPair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pairing_card_title"
                style="@style/NeurioSectionTitle" />

            <TextView
                android:id="@+id/tvPairHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:gravity="center"
                android:hint="@string/code_hint"
                android:importantForAutofill="no"
                android:inputType="number"
                android:letterSpacing="0.4"
                android:maxLength="6"
                android:textColor="@color/accent_cyan"
                android:textColorHint="@color/text_dim"
                android:textSize="22sp" />

            <Button
                android:id="@+id/btnConnect"
                style="@style/NeurioBigButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/connect" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
