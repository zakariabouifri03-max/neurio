// Resources for NeurioApkPlayer.exe
#include <windows.h>
#include "resource.h"

IDI_APP       ICON    "app.ico"
IDR_HOME_HTML RCDATA  "home.html"
1             RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Neurio"
            VALUE "FileDescription", "Neurio APK Player - play Android HTML5 games on Windows"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "NeurioApkPlayer"
            VALUE "LegalCopyright", "Neurio. Uses miniz (MIT) and Microsoft WebView2."
            VALUE "OriginalFilename", "NeurioApkPlayer.exe"
            VALUE "ProductName", "Neurio APK Player"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
