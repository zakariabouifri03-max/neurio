# ---------------------------------------------------------------------------
# Prism Studio — environment
# Copy to .env.local and fill in real values. Every secret below is optional:
# features degrade gracefully and the UI clearly marks what needs configuring.
# ---------------------------------------------------------------------------

# Database. Defaults to a per-user data directory OUTSIDE the repository
# (~/.prism-studio/prism.db) so designs and uploads survive a re-deploy.
# Override with:
#   DATABASE_URL="file:./dev.db"                       # SQLite in the project
#   DATABASE_URL="postgresql://user:pass@host/prism"   # Postgres
#   PRISM_DATA_DIR="/var/lib/prism"                    # move the whole data dir

# Session signing secret (generate: openssl rand -base64 48)
AUTH_SECRET="dev-only-secret-change-me-in-production-0123456789abcdef"

# Public base url
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Object storage: local | s3 | r2
STORAGE_DRIVER="local"
# Local uploads default to <data dir>/uploads (next to the database).
# STORAGE_LOCAL_DIR="/var/lib/prism/uploads" 
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""

# AI providers — leave empty to use the built-in offline engines.
# The studio detects configured providers at runtime and switches automatically.
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_AI_API_KEY=""
# REPLICATE_API_TOKEN=""
# STABILITY_API_KEY=""
# FAL_API_KEY=""
AI_PROVIDER="auto"          # auto | openai | anthropic | google | local
AI_IMAGE_PROVIDER="auto"    # auto | openai | stability | replicate | fal | local

# Stock media providers (optional)
# UNSPLASH_ACCESS_KEY=""
# PEXELS_API_KEY=""

# Google sign-in (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Email delivery for password reset (optional; links are logged in dev)
# SMTP_URL=""
EMAIL_FROM="no-reply@prism.studio"

SEED_ADMIN_EMAIL="demo@prism.studio"
