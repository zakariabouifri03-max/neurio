<Application x:Class="AdzakDownloadPro.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AdzakDownloadPro.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The active theme dictionary (swapped at runtime by ThemeService). -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:SpeedConverter x:Key="SpeedConverter" />
            <conv:SizeConverter x:Key="SizeConverter" />
            <conv:EtaConverter x:Key="EtaConverter" />
            <conv:PercentConverter x:Key="PercentConverter" />
            <conv:StatusBrushConverter x:Key="StatusBrushConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibility" />
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
            <conv:EmptyStringToCollapsedConverter x:Key="EmptyStringToCollapsedConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
