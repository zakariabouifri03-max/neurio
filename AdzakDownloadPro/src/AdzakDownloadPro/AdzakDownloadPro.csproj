<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>AdzakDownloadPro</RootNamespace>
    <!-- The published executable is ADZAK-DOWNLOAD-PRO.exe -->
    <AssemblyName>ADZAK-DOWNLOAD-PRO</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>ADZAK DOWNLOAD PRO — a Windows download manager with honest, measured performance.</Description>
    <Authors>ADZAK</Authors>
    <Product>ADZAK DOWNLOAD PRO</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdzakDownloadPro.Core\AdzakDownloadPro.Core.csproj" />
  </ItemGroup>

</Project>
